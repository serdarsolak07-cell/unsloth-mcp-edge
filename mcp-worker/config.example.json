{
  "host": "0.0.0.0",
  "port": 8788,
  "allowed_paths": ["~"],
  "protected_paths": ["~/.ssh", "~/.gnupg", "~/.config/mcp-bearer.token"],
  "allowlist_commands": [
    "ls", "pwd", "df", "du", "cat", "head", "tail", "wc",
